{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/nexus/workflow-graph.schema.json",
  "title": "WorkflowGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "name", "entry_node_id", "nodes", "edges", "terminal_node_ids"],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "entry_node_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "terminal_node_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "agent_role", "output_schema_ref"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["agent", "terminal"]
        },
        "agent_role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "requires_human_approval": {
          "type": "boolean",
          "default": false
        },
        "output_schema_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "condition"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["always", "expression", "approval", "timeout"]
            },
            "expression": {
              "type": "string"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "expression"
                  }
                }
              },
              "then": {
                "required": ["expression"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "timeout"
                  }
                }
              },
              "then": {
                "required": ["timeout_seconds"]
              }
            }
          ]
        }
      }
    }
  }
}
